# Copy to .env.local for local dev

NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_PAYMENT_ACCOUNT=0799999999999
NEXT_PUBLIC_PLUGIN_DOWNLOAD_URL=https://github.com/BenTheBlaster99/sketchlib-plugin/releases/latest/download/sketchlib-plugin-v1.0.1-beta.zip
